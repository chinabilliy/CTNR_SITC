# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
.venv/
venv/
env/

# 数据库备份（运行时产生，含业务数据，不入库）
app/backups/

# 上传的放箱图片（运行时用户上传，不入库；目录由 config.py 自动创建）
app/uploads/*
!app/uploads/.gitkeep

# 运行时导出的 Excel（文件名带时间戳）
app/excel_templates/*_导出_*.xlsx

# 验证/测试脚本与临时产物
work/

# WorkBuddy 工作区内部记忆
.workbuddy/

# 操作系统/编辑器临时文件
.DS_Store
Thumbs.db
*.swp
*.tmp
